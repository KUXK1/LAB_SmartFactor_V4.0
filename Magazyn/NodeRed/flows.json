    {
        "id": "ee8497468f62001a",
        "type": "function",
        "z": "f4a92d5af03e23a9",
        "name": "function 2",
        "func": "// Pobierz poprzedni stan z kontekstu\nvar state_switch = context.get(\"state_switch\") || false;\n\nif (typeof msg.payload === \"boolean\") {\n    state_switch = msg.payload;\n}\nelse if (typeof msg.payload === \"string\") {\n    state_switch = !state_switch;  // toggle\n}\n\n// Zapisz nowy stan w kontekście\ncontext.set(\"state_switch\", state_switch);\n\n// Przekaż jako msg.payload\nmsg.payload = state_switch;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
